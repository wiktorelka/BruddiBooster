# BruddiBooster configuration.
# Real environment variables override anything set here.

# Port the panel listens on. Nginx Proxy Manager forwards to this.
PORT=3000

# Which network interface to bind.
#   0.0.0.0    all interfaces - required when your proxy runs on another machine
#   127.0.0.1  this machine only - use when the proxy is on the same host
HOST=0.0.0.0

# Set to 1 because Nginx Proxy Manager sits in front. This makes the panel use the
# real visitor IP from the proxy instead of the proxy's own address. Without it every
# visitor shares a single rate-limit bucket, so one attacker's failed logins would
# lock everyone out. Only correct while a proxy really is in front.
TRUST_PROXY=0
